{
  "openapi": "3.0.0",
  "info": {
    "title": "WA Porta API",
    "version": "1.1.1",
    "description": "WhatsApp Gateway REST API powered by Baileys"
  },
  "components": {
    "schemas": {
      "WebhookMessagePayload": {
        "type": "object",
        "description": "JSON body POSTed to each registered webhook URL when an incoming WhatsApp message is received. Fields are sourced from the wa-multi-session event for the session.",
        "required": [
          "event",
          "sessionId",
          "raw"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "message.received"
            ],
            "example": "message.received"
          },
          "sessionId": {
            "type": "string",
            "example": "my-session"
          },
          "messageId": {
            "type": "string",
            "example": "ABCDEF123456"
          },
          "sender": {
            "type": "string",
            "example": "6281234567890@s.whatsapp.net"
          },
          "recipient": {
            "type": "string",
            "example": "6289876543210@s.whatsapp.net"
          },
          "timestamp": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "example": 1700000000
          },
          "messageType": {
            "type": "string",
            "example": "text"
          },
          "content": {
            "description": "Message content metadata (authentication secrets redacted)"
          },
          "raw": {
            "description": "Full raw wa-multi-session event (authentication secrets redacted)"
          }
        }
      },
      "WebhookUrlRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4e5f6a7b8"
          },
          "sessionId": {
            "type": "string",
            "example": "my-session"
          },
          "url": {
            "type": "string",
            "example": "https://example.com/whatsapp"
          },
          "normalizedUrl": {
            "type": "string",
            "example": "https://example.com/whatsapp"
          },
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "sessionId",
          "url",
          "normalizedUrl",
          "enabled",
          "createdAt",
          "updatedAt"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Invalid webhook URL"
          }
        },
        "required": [
          "error"
        ]
      },
      "DuplicateWebhookUrlError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "duplicate_webhook_url"
            ],
            "example": "duplicate_webhook_url"
          },
          "existingId": {
            "type": "string",
            "example": "a1b2c3d4e5f6a7b8"
          }
        },
        "required": [
          "error",
          "existingId"
        ]
      },
      "CreateWebhookUrlRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://example.com/whatsapp",
            "description": "Absolute HTTPS URL, max 2048 characters, no fragment"
          }
        },
        "required": [
          "url"
        ]
      },
      "DeleteWebhookUrlResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4e5f6a7b8"
          },
          "sessionId": {
            "type": "string",
            "example": "my-session"
          }
        },
        "required": [
          "id",
          "sessionId"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/whatsapp/sessions": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "List all sessions",
        "responses": {
          "200": {
            "description": "List of session IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "sessions"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/sessions/{sessionId}": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Start a new session",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Session starting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "sessionId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "sessionId"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Delete a session",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Session deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "sessionId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "sessionId"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Get session status",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Session info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "connecting",
                        "connected",
                        "disconnected"
                      ]
                    },
                    "user": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "lid": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "sessionId",
                    "status",
                    "user"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/sessions/{sessionId}/qr": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Get QR code for a session",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "QR code data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qr": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "qr"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/sessions/{sessionId}/pairing-code": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Start a session with pairing code",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phoneNumber": {
                    "type": "string",
                    "example": "6281234567890"
                  }
                },
                "required": [
                  "phoneNumber"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pairing code generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "sessionId": {
                      "type": "string"
                    },
                    "pairingCode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "sessionId",
                    "pairingCode"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/send/text": {
      "post": {
        "tags": [
          "Messaging"
        ],
        "summary": "Send a text message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "example": "my-session"
                  },
                  "to": {
                    "type": "string",
                    "example": "6281234567890"
                  },
                  "text": {
                    "type": "string",
                    "example": "Hello!"
                  },
                  "isGroup": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sessionId",
                  "to",
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Delivery failed after retries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "delivery_failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "attempts": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "error",
                    "message",
                    "attempts"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/send/image": {
      "post": {
        "tags": [
          "Messaging"
        ],
        "summary": "Send an image",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "example": "my-session"
                  },
                  "to": {
                    "type": "string",
                    "example": "6281234567890"
                  },
                  "media": {
                    "type": "string",
                    "description": "URL or base64 of image"
                  },
                  "text": {
                    "type": "string"
                  },
                  "isGroup": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sessionId",
                  "to",
                  "media"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Delivery failed after retries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "delivery_failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "attempts": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "error",
                    "message",
                    "attempts"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/send/document": {
      "post": {
        "tags": [
          "Messaging"
        ],
        "summary": "Send a document",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "example": "my-session"
                  },
                  "to": {
                    "type": "string",
                    "example": "6281234567890"
                  },
                  "media": {
                    "type": "string",
                    "description": "URL or base64 of document"
                  },
                  "filename": {
                    "type": "string",
                    "example": "document.pdf"
                  },
                  "text": {
                    "type": "string"
                  },
                  "isGroup": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sessionId",
                  "to",
                  "media",
                  "filename"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Delivery failed after retries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "delivery_failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "attempts": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "error",
                    "message",
                    "attempts"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/check": {
      "get": {
        "tags": [
          "Messaging"
        ],
        "summary": "Check if a number exists on WhatsApp",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "6281234567890"
            },
            "required": true,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "false"
            },
            "required": false,
            "name": "isGroup",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Check result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exists": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "exists"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/sessions/{sessionId}/webhooks": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Add a webhook URL for a session",
        "description": "Register an HTTPS webhook URL to receive realtime incoming WhatsApp message events for the specified session. Multiple webhook URLs may be registered per session. Each registered URL will receive a POST request with a WebhookMessagePayload body when a message arrives.",
        "security": [
          {
            "Bearer": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookUrlRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook URL created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookUrlRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sessionId or webhook URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Duplicate webhook URL for this session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateWebhookUrlError"
                }
              }
            }
          },
          "500": {
            "description": "Webhook URL store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "List webhook URLs for a session",
        "description": "Returns all webhook URL records for the specified session sorted by creation time ascending. No authentication secrets or WhatsApp credentials are included in the response.",
        "security": [
          {
            "Bearer": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook URL records sorted by createdAt ascending",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookUrlRecord"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid sessionId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Webhook URL store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/whatsapp/sessions/{sessionId}/webhooks/{id}": {
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Delete a webhook URL",
        "description": "Removes a webhook URL record by its id. The sessionId in the path must match the record's session; records from other sessions return 404.",
        "security": [
          {
            "Bearer": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "example": "my-session"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "example": "a1b2c3d4e5f6a7b8"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook URL deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteWebhookUrlResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sessionId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Webhook URL not found or session mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Webhook URL store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}