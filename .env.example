PORT=3000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
# Optional: set a default API key usable without creating one from the dashboard
# DEFAULT_API_KEY=wap_your_static_key_here

# Optional: Email notification for failed message delivery
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=waporta@yourdomain.com
# NOTIFY_EMAIL=admin@yourdomain.com

# Optional: Webhook notification for failed message delivery
# NOTIFY_WEBHOOK_URL=https://your-webhook-endpoint.com/waporta

# Optional: Anti-ban guards (defaults shown). Set a value to 0 to disable.
# Masa warm-up setelah sesi tersambung; pengiriman ditolak selama jendela ini.
# Dibedakan: nomor yang BARU pertama kali di-pair menunggu jauh lebih lama
# daripada sesi lama yang sekadar tersambung ulang.
# SEND_WARMUP_COLD_MS=1800000
# SEND_WARMUP_RECONNECT_MS=60000
# SEND_WARMUP_MS adalah env lama. Bila disetel, nilainya dipakai untuk KEDUA
# tingkat di atas (termasuk 0 untuk mematikan warm-up sepenuhnya).
# SEND_WARMUP_MS=300000
# Batas laju per sesi: maksimum SEND_RATE_MAX pesan per SEND_RATE_WINDOW_MS.
# SEND_RATE_MAX=20
# SEND_RATE_WINDOW_MS=60000
# Kuota harian bertahap untuk sesi baru: batas hari ke-1, ke-2, ke-3, dst.
# Setelah daftar habis, tidak ada batas harian. Sesi yang sudah ada sebelum
# fitur ini diperkenalkan dianggap matang dan tidak terkena. Isi 0 untuk mati.
# SEND_RAMPUP_DAILY=20,50,100,200
# Rentang durasi (ms) indikator "mengetik" sebelum tiap pesan dikirim.
# SEND_TYPING_MIN_MS=800
# SEND_TYPING_MAX_MS=2500

# Optional: Retry pengiriman.
# Timeout TIDAK di-retry secara default karena ambigu — pesan bisa saja sudah
# masuk ke koneksi, sehingga kirim ulang menghasilkan pesan ganda di penerima.
# Setel true bila lebih memilih risiko duplikasi daripada kehilangan pesan.
# SEND_RETRY_ON_TIMEOUT=false
# SEND_MAX_RETRIES=3
# SEND_RETRY_BASE_DELAY_MS=3000

# Optional: Pelacakan status pengiriman (in-memory).
# Menyediakan GET /api/whatsapp/messages/{messageId}. Setel 0 untuk mematikan.
# MESSAGE_STATE_MAX=1000
# MESSAGE_STATE_TTL_MS=3600000

# Optional: Kirim webhook "message.status" setiap kali status pesan berubah.
# Mati secara default: peristiwa ini bisa muncul 3-4 kali per pesan.
# WEBHOOK_STATUS_EVENTS=false

# Optional: Jejak pesan ke data/logs/YYYY-MM-DD.jsonl.
# off = tidak mencatat (default); meta = metadata saja, nomor dimasking, TANPA
# isi pesan; full = termasuk isi pesan.
# Perkiraan pada level meta: ~200 byte/entri, ~200 KB per 1000 pesan/hari.
# MESSAGE_LOG_LEVEL=off
# MESSAGE_LOG_RETENTION_DAYS=7
# MESSAGE_LOG_MAX_BYTES=10485760

# Optional: Cetak payload lengkap pesan masuk ke stdout (berisi isi percakapan).
# LOG_MESSAGE_PAYLOAD=false
