PORT=3000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
# Optional: set a default API key usable without creating one from the dashboard
# DEFAULT_API_KEY=wap_your_static_key_here

# Optional: Email notification for failed message delivery
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=waporta@yourdomain.com
# NOTIFY_EMAIL=admin@yourdomain.com

# Optional: Webhook notification for failed message delivery
# NOTIFY_WEBHOOK_URL=https://your-webhook-endpoint.com/waporta

# Optional: Anti-ban guards (defaults shown). Set a value to 0 to disable.
# Masa warm-up setelah sesi tersambung/tersambung-ulang; pengiriman ditolak
# selama jendela ini (mencegah burst tepat setelah pairing).
# SEND_WARMUP_MS=300000
# Batas laju per sesi: maksimum SEND_RATE_MAX pesan per SEND_RATE_WINDOW_MS.
# SEND_RATE_MAX=20
# SEND_RATE_WINDOW_MS=60000
# Rentang durasi (ms) indikator "mengetik" sebelum tiap pesan dikirim.
# SEND_TYPING_MIN_MS=800
# SEND_TYPING_MAX_MS=2500
